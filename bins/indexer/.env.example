# Copy to .env beside it. The indexer's own variables, read before the shared
# ones in the root .env.

OTEL_SERVICE_NAME=indexer

# Probes only, on a port of its own. 3001 is also the Node indexer's, so a
# `cargo run -p indexer` beside it wants PORT=3101.
HOST=0.0.0.0
PORT=3001

# Required, no default: an indexer pointed at the wrong chain produces
# plausible, wrong data.
CHAIN_ID=1

# Required. Comma-separated and tried in order, so the first is the preferred
# provider. Each URL usually carries an API key, so a refusal names an entry's
# position and never its text — and this file is not where a real key goes.
RPC_URLS=https://eth.drpc.org

# How deep a reorg is assumed to reach. Read by the reorg detector, never by
# the loop.
FINALITY_DEPTH=128

# Used only when there is no stored cursor. Unset, it is the Core Hub's first
# block, eight before the Main Spoke's: the floor is the earliest contract
# followed, or the first AddAsset is missed.
# START_BLOCK=24720891

# Blocks per dispatch while catching up, halved at runtime if a provider
# rejects the range as too wide.
MAX_RANGE_SIZE=1000
POLL_INTERVAL_MS=4000
RPC_TIMEOUT_MS=10000

# How long the loop may go without progress before /health/ready fails.
STALL_THRESHOLD_MS=300000

# Set false to boot the probes without indexing anything.
AUTOSTART=true

# The contracts followed. Configuration rather than constants, so a second
# Spoke or Hub is a second registration and not an edit. Not part of the cursor
# key: repointing a deployment resumes from the cursor built for the first one.
MAIN_SPOKE_ADDRESS=0x94e7a5dcbe816e498b89ab752661904e2f56c485
CORE_HUB_ADDRESS=0xcca852bc40e560adc3b1cc58ca5b55638ce826c9
